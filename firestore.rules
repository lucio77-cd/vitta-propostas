rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // FUNÇÕES AUXILIARES
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // O documento existente pertence ao usuário autenticado?
    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Valida o mapa "signature" enviado pelo cliente final.
    // Obrigatórios: name (string) e image (PNG em base64).
    // Opcionais:    document (CPF/CNPJ) e userAgent, ambos com tamanho limitado.
    function validSignature(sig) {
      return sig is map
        && sig.keys().hasOnly(['name', 'image', 'document', 'userAgent'])
        && sig.keys().hasAll(['name', 'image'])
        && sig.name is string
        && sig.name.size() > 0 && sig.name.size() <= 120
        && sig.image is string
        && sig.image.matches('^data:image/png;base64,.+')
        && sig.image.size() <= 700000                       // abaixo do limite de 1 MB por documento
        && (!('document' in sig)  || (sig.document is string  && sig.document.size()  <= 30))
        && (!('userAgent' in sig) || (sig.userAgent is string && sig.userAgent.size() <= 500));
    }

    // Transição de assinatura feita pelo CLIENTE (autenticado ou não):
    //  - o documento precisa estar 'pending';
    //  - só podem mudar status, signature, signedAt e contentHash (os quatro, obrigatoriamente);
    //  - status vira 'signed', signedAt é EXATAMENTE o horário do servidor
    //    e contentHash é um SHA-256 em hexadecimal (64 caracteres).
    // Qualquer outro campo (itens, total, título, ownerId...) faz a regra falhar.
    function isClientSigning() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == 'pending'
        && changed.hasOnly(['status', 'signature', 'signedAt', 'contentHash'])
        && changed.hasAll(['status', 'signature', 'signedAt', 'contentHash'])
        && request.resource.data.status == 'signed'
        && request.resource.data.signedAt == request.time
        && request.resource.data.contentHash is string
        && request.resource.data.contentHash.matches('^[a-f0-9]{64}$')
        && validSignature(request.resource.data.signature);
    }

    // =====================================================================
    // COLEÇÃO: proposals
    // =====================================================================
    match /proposals/{proposalId} {

      // LEITURA PONTUAL (get): qualquer pessoa que souber o ID exato do documento.
      // O ID automático do Firestore (20 caracteres) funciona como o "segredo" do link.
      allow get: if true;

      // LISTAGEM (list/query): somente o profissional autenticado e apenas das
      // próprias propostas. Deslogados nunca conseguem varrer a coleção.
      allow list: if isOwner();

      // CRIAÇÃO: o dono é quem está logado; nasce 'pending', sem assinatura
      // e sem data de assinatura.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.signature == null
        && request.resource.data.get('signedAt', null) == null
        && request.resource.data.get('contentHash', null) == null;

      // ATUALIZAÇÃO PELO DONO: somente enquanto 'pending'. Não pode trocar o
      // ownerId nem o createdAt, nem "assinar" por conta própria
      // (status segue 'pending', signature e signedAt seguem nulos).
      allow update: if isOwner()
        && resource.data.status == 'pending'
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == 'pending'
        && request.resource.data.signature == null
        && request.resource.data.get('signedAt', null) == null
        && request.resource.data.get('contentHash', null) == null;

      // ATUALIZAÇÃO PELO CLIENTE: apenas o ato de assinar (ver isClientSigning).
      // Depois de 'signed', nenhuma das duas regras de update passa: documento travado.
      allow update: if isClientSigning();

      // EXCLUSÃO: somente o dono, em qualquer status (inclusive 'signed').
      allow delete: if isOwner();
    }

    // =====================================================================
    // COLEÇÃO: users (perfil do profissional) - somente o próprio usuário
    // =====================================================================
    function optStr(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'document', 'city', 'phone', 'activeContractId', 'updatedAt'])
        && optStr(request.resource.data, 'name', 120)
        && optStr(request.resource.data, 'document', 30)
        && optStr(request.resource.data, 'city', 80)
        && optStr(request.resource.data, 'phone', 30)
        && optStr(request.resource.data, 'activeContractId', 40)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    // =====================================================================
    // COLEÇÃO: contracts (modelos de contrato em PDF) - versões IMUTÁVEIS
    // O cliente precisa ler o modelo pelo ID (vindo da proposta); ninguém lista.
    // Não tem dados de cliente: é só o PDF em branco e a posição dos campos.
    // =====================================================================
    match /contracts/{contractId} {
      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['ownerId', 'name', 'pdf', 'pages', 'fields', 'createdAt'])
        && request.resource.data.keys().hasAll(['ownerId', 'name', 'pdf', 'pages', 'fields', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.pdf is string
        && request.resource.data.pdf.size() <= 850000          // ~600 KB de PDF em base64
        && request.resource.data.pages is list
        && request.resource.data.pages.size() >= 1 && request.resource.data.pages.size() <= 30
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 40
        && request.resource.data.createdAt == request.time;

      // Imutável: propostas assinadas dependem desta versão. Sem update nem delete.
      allow update, delete: if false;
    }

    // Todo o resto do banco permanece bloqueado por padrão.
  }
}
